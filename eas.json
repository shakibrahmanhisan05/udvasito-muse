{
  "cli": { "version": ">= 13.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "",
        "EXPO_PUBLIC_CONVEX_SITE_URL": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "",
        "EXPO_PUBLIC_CONVEX_SITE_URL": ""
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "",
        "EXPO_PUBLIC_CONVEX_SITE_URL": ""
      }
    }
  },
  "submit": { "production": {} }
}
