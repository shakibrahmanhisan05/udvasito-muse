# UDVASITO environment variables — NAMES ONLY. Never put real values in this file.
# Where each value lives: Convex env / Vercel env / EAS env (see docs/roadmap.md §6 runbooks).
# Client (bundled into the app — public by design, no secrets)
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
# Convex CLI / deployment (local tooling only)
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
# Better Auth + Google sign-in (Convex env — RB-4)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AI (Convex env — RB-9)
GEMINI_API_KEY=
# Telegram verification bot (Convex env — RB-5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Web Push (Convex env — RB-8)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Share-card images (Convex env — RB-9)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Monitoring (CI / release tooling)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# EAS
EXPO_TOKEN=
